use sys
use toml
use json
use strings

fun read_toml(view string path) -> result[string, string] {
    try {
        var content = sys.read(path)
        return Ok(toml.parse(content))
    } catch (err) {
        return Err("toml_utils.read: " + err)
    }
}

fun write_toml_file(view string path, view string json_data) -> result[bool, string] {
    try {
        sys.write(path, toml.stringify(json_data))
        return Ok(true)
    } catch (err) {
        return Err("toml_utils.write: " + err)
    }
}

fun get_package_name(view string toml_json) -> result[string, string] {
    try {
        var pkg = json.get(toml_json, "package")
        if (strings.is_empty(pkg) || pkg == "nil") {
            return Err("toml_utils: missing [package]")
        }
        var name = json.get(pkg, "name")
        if (strings.is_empty(name) || name == "nil") {
            return Err("toml_utils: missing 'name' in [package]")
        }
        return Ok(name)
    } catch (err) {
        return Err("toml_utils: " + err)
    }
}

fun get_entry(view string toml_json) -> result[string, string] {
    try {
        var pkg = json.get(toml_json, "package")
        if (strings.is_empty(pkg) || pkg == "nil") {
            return Err("toml_utils: missing [package]")
        }
        var entry = json.get(pkg, "entry")
        if (strings.is_empty(entry) || entry == "nil") {
            return Err("toml_utils: missing 'entry' in [package]")
        }
        return Ok(entry)
    } catch (err) {
        return Err("toml_utils: " + err)
    }
}

fun get_dependencies(view string toml_json) -> string {
    try {
        var deps = json.get(toml_json, "dependencies")
        if (strings.is_empty(deps) || deps == "nil") {
            return "{}"
        }
        return deps
    } catch (_) {
        return "{}"
    }
}
