// Bubble sort benchmark in NTSC
fun main() -> int {
    var arr = [64, 34, 25, 12, 22, 11, 90, 88, 45, 50, 33, 77, 99, 18, 7];
    var int n = 15;
    var int i = 0;
    while (i < n) {
        var int j = 0;
        while (j < n - i - 1) {
            if (arr[j] > arr[j + 1]) {
                var int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return arr[0] + arr[1] + arr[2] + arr[3] + arr[4];
}
